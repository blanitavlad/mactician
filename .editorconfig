root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{swift,c,cpp,h,hpp}]
indent_size = 4

[*.{command,sh,zsh}]
indent_size = 4

[*.{md,json,plist,xml,strings}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
