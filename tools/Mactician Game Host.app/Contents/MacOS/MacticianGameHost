#!/bin/zsh
set -euo pipefail

readonly PROJECT_DIR="${0:A:h:h:h:h:h}"
source "$PROJECT_DIR/scripts/android-environment.sh"
SDK_ROOT="$(tft_resolve_android_sdk_root)"
readonly SDK_ROOT
EMULATOR="$(tft_resolve_emulator)"
readonly EMULATOR
readonly ADB_SERVER_PORT="${TFT_ADB_SERVER_PORT:-5038}"

if [[ ! -x "$EMULATOR" ]]; then
    print -u2 "Android Emulator executable not found: $EMULATOR"
    exit 1
fi

if [[ "$ADB_SERVER_PORT" != <-> ]] \
        || (( ADB_SERVER_PORT < 1024 || ADB_SERVER_PORT > 65534 )); then
    print -u2 "TFT_ADB_SERVER_PORT must be a TCP port from 1024 through 65534."
    exit 2
fi

export ANDROID_SDK_ROOT="$SDK_ROOT"
export ANDROID_AVD_HOME="$(tft_resolve_avd_home)"
unset ADB_SERVER_SOCKET ANDROID_ADB_SERVER_ADDRESS
export ANDROID_ADB_SERVER_PORT="$ADB_SERVER_PORT"

exec "$EMULATOR" "$@"
